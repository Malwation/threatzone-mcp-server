# Transport: "http" (default) exposes Streamable HTTP at MCP_HTTP_HOST:MCP_HTTP_PORT/mcp.
# Set to "stdio" only for local CLI debugging via an MCP client that spawns the process.
MCP_TRANSPORT=http

# HTTP listener. Default to loopback so a reverse proxy (nginx/Caddy) handles TLS+auth.
# Change MCP_HTTP_HOST to 0.0.0.0 only after fronting this with a proxy.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=7860

# VNC tuning (milliseconds)
VNC_CONNECT_TIMEOUT=10000
VNC_SCREENSHOT_TIMEOUT=5000

# RTC connect budget covers signaling + first decoded keyframe (milliseconds)
RTC_CONNECT_TIMEOUT=15000

# Threat.Zone Public API credentials.
# THREATZONE_API_TOKEN is REQUIRED before any tz_* tool can be invoked — no default is provided.
# Issue tokens from your workspace's API keys page in the Threat.Zone UI, then either:
#   - Set THREATZONE_API_TOKEN at server startup (single-tenant), or
#   - Pass `api_token` per-call in each tool invocation (multi-tenant override).
#
# THREATZONE_API_BASE_URL: defaults to https://app.threat.zone/public-api when unset. Change it on onpremise deployments, usually Malwation team handles it but double check.
# THREATZONE_API_BASE_URL=https://acme.threatzone.local/public-api
